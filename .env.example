# Bybit API credentials (testnet)
BYBIT_API_KEY=your_api_key_here
BYBIT_API_SECRET=your_api_secret_here

# Use testnet (true/false)
BYBIT_TESTNET=true

# Trading configuration
SYMBOL=BTCUSDT
TRADE_QTY=0.001
LEVERAGE=5
TAKE_PROFIT_PCT=2.0
STOP_LOSS_PCT=1.0

# Strategy settings
RSI_PERIOD=14
RSI_OVERBOUGHT=70
RSI_OVERSOLD=30
EMA_FAST=9
EMA_SLOW=21
SCAN_INTERVAL_SECONDS=60

# OpenClaw agent (optional)
OPENCLAW_ENABLED=false
OPENCLAW_API_URL=
OPENCLAW_API_KEY=
